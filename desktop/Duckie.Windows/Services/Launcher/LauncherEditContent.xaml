<UserControl x:Class="Duckie.Windows.Services.Launcher.LauncherEditContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Duckie.Shared.Utils.Localization;assembly=Duckie.Shared"
             FontFamily="{StaticResource DesignFontFamily}" UseLayoutRounding="True">
    <StackPanel>
        <TextBlock Text="{loc:Localize Label_ConfigName}" Style="{StaticResource DesignRowTitle}" Margin="0,0,0,8"/>
        <TextBox x:Name="NameTextBox" Style="{StaticResource DesignInput}" Margin="0,0,0,16"
                 AutomationProperties.Name="{loc:Localize Label_ConfigName}"/>
        <TextBlock Text="{loc:Localize Launcher_Target}" Style="{StaticResource DesignRowTitle}" Margin="0,0,0,8"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{loc:Localize Launcher_Browse}" Style="{StaticResource DesignButton}" Margin="8,0,0,0" Click="Browse_Click"/>
            <TextBox x:Name="TargetTextBox" Style="{StaticResource DesignInput}"
                     AutomationProperties.Name="{loc:Localize Launcher_Target}"/>
        </DockPanel>
    </StackPanel>
</UserControl>
