<UserControl x:Class="Duckie.Windows.Services.Launcher.LauncherEditContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Duckie.Shared.Utils.Localization;assembly=Duckie.Shared">
    <StackPanel>
        <TextBlock Text="{loc:Localize Label_ConfigName}" FontSize="13" Margin="0,0,0,8"/>
        <TextBox x:Name="NameTextBox" Height="32" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
        <TextBlock Text="{loc:Localize Launcher_Target}" FontSize="13" Margin="0,0,0,8"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{loc:Localize Launcher_Browse}" Margin="8,0,0,0" Padding="10,3" Click="Browse_Click"/>
            <TextBox x:Name="TargetTextBox" Height="32" FontSize="13" VerticalContentAlignment="Center"/>
        </DockPanel>
    </StackPanel>
</UserControl>
