<UserControl x:Class="Duckie.Windows.Services.Launcher.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Duckie.Shared.Views.Common;assembly=Duckie.Shared"
             xmlns:loc="clr-namespace:Duckie.Shared.Utils.Localization;assembly=Duckie.Shared">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,26,28,28" MaxWidth="760">
            <DockPanel Margin="0,0,0,26">
                <Button DockPanel.Dock="Right" Content="{loc:Localize Tool_Add}" Style="{StaticResource ToolPrimaryButton}" Click="Add_Click"/>
                <TextBlock Text="{loc:Localize Nav_Launcher}" Style="{StaticResource ToolTitle}"/>
            </DockPanel>
            <ItemsControl x:Name="Items"><ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="{StaticResource ToolLineBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Target}" Foreground="{StaticResource ToolMutedBrush}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}"/>
                        </StackPanel>
                        <common:HotKeyEditor Grid.Row="1" Grid.ColumnSpan="2" Operation="{Binding Action}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{loc:Localize Launcher_Run}" Style="{StaticResource ToolQuietButton}" Tag="{Binding}" Click="Run_Click"/>
                            <Button Content="{loc:Localize Btn_Edit}" Style="{StaticResource ToolQuietButton}" Tag="{Binding}" Click="Edit_Click"/>
                            <Button Content="{loc:Localize Btn_Delete}" Style="{StaticResource ToolQuietButton}" Foreground="#B42318" Tag="{Binding}" Click="Delete_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
