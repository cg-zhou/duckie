<UserControl x:Class="Duckie.Windows.Services.Launcher.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Duckie.Shared.Views.Common;assembly=Duckie.Shared"
             xmlns:loc="clr-namespace:Duckie.Shared.Utils.Localization;assembly=Duckie.Shared"
             Background="Transparent" FontFamily="{StaticResource DesignFontFamily}" UseLayoutRounding="True">
    <UserControl.Resources>
        <loc:LocalizationConverter x:Key="ActionLocalization"/>
        <loc:LocalizationParameter x:Key="RunLabel" Key="Launcher_Run"/>
        <loc:LocalizationParameter x:Key="EditLabel" Key="Btn_Edit"/>
        <loc:LocalizationParameter x:Key="DeleteLabel" Key="Btn_Delete"/>
        <loc:LocalizationParameter x:Key="HotkeyLabel" Key="Nav_Hotkey"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource DesignPage}">
            <DockPanel LastChildFill="True" Margin="0,0,0,24">
                <Button DockPanel.Dock="Right" Content="{loc:Localize Tool_Add}" Style="{StaticResource DesignPrimaryButton}"
                        Click="Add_Click" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock Text="{loc:Localize Nav_Launcher}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DesignPageTitle}">
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>

            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource DesignCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=Items}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ItemsControl x:Name="Items" AlternationCount="2147483647">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource DesignDivider}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <common:SettingRow Title="{Binding Name}" Description="{Binding Target}" ToolTip="{Binding Target}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding CurrentCulture, Source={x:Static loc:EmbeddedLocalizationManager.Instance}, Converter={StaticResource ActionLocalization}, ConverterParameter={StaticResource RunLabel}}"
                                                Style="{StaticResource DesignQuietButton}" Tag="{Binding}" Click="Run_Click"/>
                                        <Button Content="{Binding CurrentCulture, Source={x:Static loc:EmbeddedLocalizationManager.Instance}, Converter={StaticResource ActionLocalization}, ConverterParameter={StaticResource EditLabel}}"
                                                Style="{StaticResource DesignQuietButton}" Tag="{Binding}" Click="Edit_Click"/>
                                        <Button Content="{Binding CurrentCulture, Source={x:Static loc:EmbeddedLocalizationManager.Instance}, Converter={StaticResource ActionLocalization}, ConverterParameter={StaticResource DeleteLabel}}"
                                                Style="{StaticResource DesignDangerButton}" Tag="{Binding}" Click="Delete_Click"/>
                                    </StackPanel>
                                </common:SettingRow>
                                <common:SettingRow Padding="16,0,16,16"
                                                   Title="{Binding CurrentCulture, Source={x:Static loc:EmbeddedLocalizationManager.Instance}, Converter={StaticResource ActionLocalization}, ConverterParameter={StaticResource HotkeyLabel}}">
                                    <common:HotKeyEditor Operation="{Binding Action}" AutomationProperties.Name="{Binding Name}"/>
                                </common:SettingRow>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Padding="{StaticResource DesignRowPadding}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource DesignCard}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=Items}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{loc:Localize Launcher_Empty}" Style="{StaticResource DesignRowTitle}"/>
                    <TextBlock Text="{loc:Localize Launcher_EmptyHint}" Style="{StaticResource DesignDescription}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
