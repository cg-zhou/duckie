<UserControl x:Class="Duckie.Views.PacManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Duckie.Shared.Views.Common;assembly=Duckie.Shared"
             xmlns:loc="clr-namespace:Duckie.Shared.Utils.Localization;assembly=Duckie.Shared"
             FontFamily="Segoe UI" Background="White" UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,26,28,28" MaxWidth="760">
            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="PAC" Style="{StaticResource ToolTitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,12,0">
                        <TextBlock Text="{loc:Localize PAC_Active}" Foreground="{StaticResource ToolMutedBrush}" FontSize="12" Margin="0,0,8,0"/>
                        <TextBlock x:Name="CurrentConfigText" Foreground="{StaticResource ToolTextBrush}" FontSize="12"
                                   MaxWidth="250" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ToolPrimaryButton}" Click="AddPacButton_Click" VerticalAlignment="Top" Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Localize Tool_Add}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <ItemsControl x:Name="PacItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource ToolLineBrush}" BorderThickness="0,0,0,1" Padding="0,4">
                            <Grid>
                                <RadioButton Style="{StaticResource ToolChoiceRow}" GroupName="PacProfiles"
                                             IsChecked="{Binding IsActive, Mode=OneWay}" Tag="{Binding Config}" Click="PacChoice_Click"
                                             AutomationProperties.Name="{Binding Name}">
                                    <StackPanel Margin="0,0,104,0">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource ToolTextBrush}" FontSize="14"
                                                   FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource ToolMutedBrush}" FontSize="12"
                                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}">
                                            <TextBlock.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="{loc:Localize PAC_CopyAddress}" Tag="{Binding Config}" Click="CopyPac_Click" Visibility="{Binding CanEdit, Converter={StaticResource BoolVisibility}}"/>
                                                </ContextMenu>
                                            </TextBlock.ContextMenu>
                                        </TextBlock>
                                    </StackPanel>
                                </RadioButton>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                            Visibility="{Binding CanEdit, Converter={StaticResource BoolVisibility}}">
                                    <Button Content="{loc:Localize Btn_Edit}" Style="{StaticResource ToolQuietButton}" Tag="{Binding Config}" Click="EditPacButton_Click"/>
                                    <Button Content="···" Width="32" FontWeight="Bold" FontSize="16" Style="{StaticResource ToolQuietButton}"
                                            ToolTip="{loc:Localize Tool_More}" Click="MoreButton_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{loc:Localize PAC_CopyAddress}" Tag="{Binding Config}" Click="CopyPac_Click" Visibility="{Binding CanEdit, Converter={StaticResource BoolVisibility}}"/>
                                                <Separator/>
                                                <MenuItem Header="{loc:Localize Btn_Delete}" Tag="{Binding Config}" Click="DeletePacButton_Click" Foreground="#B42318"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


            <Grid Margin="14,26,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Localize PAC_CycleHotKey}" FontSize="13" Foreground="{StaticResource ToolMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap"/>
                <common:HotKeyEditor x:Name="CycleHotKeyEditor" Grid.Column="1"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
