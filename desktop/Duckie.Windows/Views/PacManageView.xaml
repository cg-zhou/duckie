<UserControl x:Class="Duckie.Views.PacManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Duckie.Shared.Views.Common;assembly=Duckie.Shared"
             xmlns:loc="clr-namespace:Duckie.Shared.Utils.Localization;assembly=Duckie.Shared"
             Background="Transparent" FontFamily="{StaticResource DesignFontFamily}" UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <loc:LocalizationConverter x:Key="ActionLocalization"/>
        <loc:LocalizationParameter x:Key="EditLabel" Key="Btn_Edit"/>
        <loc:LocalizationParameter x:Key="DeleteLabel" Key="Btn_Delete"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource DesignPage}">
            <DockPanel LastChildFill="True" Margin="0,0,0,24">
                <Button DockPanel.Dock="Right" Content="{loc:Localize Tool_Add}" Style="{StaticResource DesignPrimaryButton}"
                        Click="AddPacButton_Click" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock Text="PAC" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DesignPageTitle}">
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>

            <Border Style="{StaticResource DesignCard}">
                <ItemsControl x:Name="PacItems" Margin="8" AlternationCount="2147483647">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource DesignDivider}">
                                            <Setter Property="Margin" Value="8,0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border CornerRadius="{StaticResource DesignControlRadius}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource DesignHoverBrush}"/></Trigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="{StaticResource DesignHoverBrush}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <RadioButton Style="{StaticResource DesignChoiceRow}" GroupName="PacProfiles"
                                                     IsChecked="{Binding IsActive, Mode=OneWay}" Tag="{Binding Config}" Click="PacChoice_Click"
                                                     AutomationProperties.Name="{Binding Name}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource DesignRowTitle}" ToolTip="{Binding Name}"/>
                                                <TextBlock Text="{Binding Description}" ToolTip="{Binding Description}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DesignDescription}">
                                                            <Setter Property="TextWrapping" Value="NoWrap"/>
                                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </RadioButton>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,8,0"
                                                    Visibility="{Binding CanEdit, Converter={StaticResource BoolVisibility}}">
                                            <Button Content="{Binding CurrentCulture, Source={x:Static loc:EmbeddedLocalizationManager.Instance}, Converter={StaticResource ActionLocalization}, ConverterParameter={StaticResource EditLabel}}"
                                                    Style="{StaticResource DesignQuietButton}"
                                                    Tag="{Binding Config}" Click="EditPacButton_Click"/>
                                            <Button Content="{Binding CurrentCulture, Source={x:Static loc:EmbeddedLocalizationManager.Instance}, Converter={StaticResource ActionLocalization}, ConverterParameter={StaticResource DeleteLabel}}"
                                                    Style="{StaticResource DesignDangerButton}"
                                                    Tag="{Binding Config}" Click="DeletePacButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Margin="0,24,0,0" Style="{StaticResource DesignCard}">
                <common:SettingRow Title="{loc:Localize PAC_CycleHotKey}">
                    <common:HotKeyEditor x:Name="CycleHotKeyEditor" AutomationProperties.Name="{loc:Localize PAC_CycleHotKey}"/>
                </common:SettingRow>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
