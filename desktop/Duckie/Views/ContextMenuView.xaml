<UserControl x:Class="Duckie.Views.ContextMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Duckie.Shared.Utils.Localization;assembly=Duckie.Shared"
             xmlns:common="clr-namespace:Duckie.Shared.Views.Common;assembly=Duckie.Shared"
             Background="White" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="MenuPreview" TargetType="Button">
            <Setter Property="Width" Value="280"/>
            <Setter Property="Margin" Value="12,0,12,12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <StackPanel>
                                <Border x:Name="Header" Padding="14,14" CornerRadius="9,9,0,0">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Right" Width="16" Height="16" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Ellipse x:Name="Indicator" Stroke="#CBD5E1" StrokeThickness="1" Fill="White"/>
                                            <Ellipse x:Name="SelectedDot" Width="8" Height="8" Fill="#0069BA" Visibility="Collapsed"/>
                                        </Grid>
                                        <TextBlock Text="{TemplateBinding Tag}" Foreground="#1E293B" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <Border CornerRadius="6" Margin="10,0,10,10" Padding="0,6">
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter TargetName="Header" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="Selector.IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#0069BA"/>
                                <Setter TargetName="Header" Property="Background" Value="#F0F7FD"/>
                                <Setter TargetName="Indicator" Property="Stroke" Value="#0069BA"/>
                                <Setter TargetName="SelectedDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#0069BA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter TargetName="Card" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,40">
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#B91C1C" Margin="6,0,6,12"/>
            <WrapPanel HorizontalAlignment="Center">
                <Button x:Name="ClassicCard" Style="{StaticResource MenuPreview}" Click="Classic_Click"
                        Tag="{loc:Localize ContextMenu_ClassicState}"
                        AutomationProperties.Name="{loc:Localize ContextMenu_ClassicState}">
                    <common:PixelImage Source="/Duckie;component/Assets/ContextMenu/classic.png"/>
                </Button>
                <Button x:Name="DefaultCard" Style="{StaticResource MenuPreview}" Click="Default_Click"
                        Tag="{loc:Localize ContextMenu_DefaultPreview}"
                        AutomationProperties.Name="{loc:Localize ContextMenu_DefaultPreview}">
                    <common:PixelImage Source="/Duckie;component/Assets/ContextMenu/windows-11.png"/>
                </Button>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
