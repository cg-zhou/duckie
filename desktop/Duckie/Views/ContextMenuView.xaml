<UserControl x:Class="Duckie.Views.ContextMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Duckie.Shared.Utils.Localization;assembly=Duckie.Shared"
             xmlns:common="clr-namespace:Duckie.Shared.Views.Common;assembly=Duckie.Shared"
             Background="Transparent" FontFamily="{StaticResource DesignFontFamily}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="MenuPreview" TargetType="Button" BasedOn="{StaticResource DesignButton}">
            <Setter Property="BorderBrush" Value="{StaticResource DesignBorderBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource DesignCardRadius}">
                            <StackPanel>
                                <Border x:Name="Header" Padding="16" CornerRadius="11,11,0,0">
                                    <DockPanel LastChildFill="True">
                                        <Grid DockPanel.Dock="Right" Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Ellipse x:Name="Indicator" Stroke="{StaticResource DesignInputBorderBrush}" StrokeThickness="1.5"/>
                                            <Ellipse x:Name="SelectedDot" Width="6" Height="6" Fill="{StaticResource DesignPrimaryBrush}" Visibility="Collapsed"/>
                                        </Grid>
                                        <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource DesignRowTitle}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <Border Margin="8,0,8,12">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                  Focusable="False" HorizontalContentAlignment="Center">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DesignInputBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="Selector.IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DesignPrimaryBrush}"/>
                                <Setter TargetName="Indicator" Property="Stroke" Value="{StaticResource DesignPrimaryBrush}"/>
                                <Setter TargetName="SelectedDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource DesignPage}" MinWidth="552">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="{loc:Localize Nav_ContextMenu}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DesignPageTitle}">
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{loc:Localize ContextMenu_SelectionHint}" Style="{StaticResource DesignDescription}"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" Style="{StaticResource DesignDescription}"
                       Foreground="{StaticResource DesignErrorBrush}" Margin="0,0,0,16"/>
            <Grid x:Name="PreviewPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="276"/>
                    <ColumnDefinition Width="276"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,0,16">
                    <Button x:Name="ClassicCard" Style="{StaticResource MenuPreview}" Click="Classic_Click" Margin="0,0,12,0"
                            Tag="{loc:Localize ContextMenu_ClassicState}"
                            AutomationProperties.Name="{loc:Localize ContextMenu_ClassicState}">
                        <common:PixelImage Source="/Duckie;component/Assets/ContextMenu/classic.png"/>
                    </Button>
                </Grid>
                <Grid Grid.Column="1" Margin="0,0,0,16">
                    <Button x:Name="DefaultCard" Style="{StaticResource MenuPreview}" Click="Default_Click" Margin="0,0,12,0"
                            Tag="{loc:Localize ContextMenu_DefaultPreview}"
                            AutomationProperties.Name="{loc:Localize ContextMenu_DefaultPreview}">
                        <common:PixelImage Source="/Duckie;component/Assets/ContextMenu/windows-11.png"/>
                    </Button>
                </Grid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
