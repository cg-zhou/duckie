<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Duckie.Views.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Duckie.Shared;component/Views/Styles/Design.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Match web-z11g tools-nav.css; keep compact desktop dimensions. -->
    <SolidColorBrush x:Key="NavigationTextBrush" Color="#475569"/>
    <SolidColorBrush x:Key="NavigationIconBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="NavigationActiveBrush" Color="#111111"/>
    <SolidColorBrush x:Key="NavigationSelectedBrush" Color="#F1F1F1"/>
    <SolidColorBrush x:Key="NavigationHoverBrush" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="NavigationPressedBrush" Color="#E5E5E5"/>

    <!-- Navigation glyphs share a 24-unit canvas and a rounded 1.8-unit stroke. -->
    <PathGeometry x:Key="NavigationContextMenu">M12,3 C8.7,3 6,5.7 6,9 V15 C6,18.3 8.7,21 12,21 C15.3,21 18,18.3 18,15 V9 C18,5.7 15.3,3 12,3 Z M12,3 V9 M6,10 H18</PathGeometry>
    <PathGeometry x:Key="NavigationNetwork">M9,3 H15 V9 H9 Z M3,15 H9 V21 H3 Z M15,15 H21 V21 H15 Z M12,9 V12 M6,15 V12 H18 V15</PathGeometry>
    <PathGeometry x:Key="NavigationLauncher">M13,3 L5,13 H11 L10,21 L19,11 H13 Z</PathGeometry>
    <PathGeometry x:Key="NavigationSettingLine">M4,7 H6 M10,7 H20 M4,17 H14 M18,17 H20 M10,7 A2,2 0 1 1 6,7 A2,2 0 1 1 10,7 M18,17 A2,2 0 1 1 14,17 A2,2 0 1 1 18,17</PathGeometry>
    <PathGeometry x:Key="NavigationInformationLine">M12,3 A9,9 0 1 1 12,21 A9,9 0 1 1 12,3 M12,11 V17 M12,7 V7.2</PathGeometry>
    <PathGeometry x:Key="NavigationSearch">M11,3 A8,8 0 1 1 11,19 A8,8 0 1 1 11,3 M17,17 L21,21</PathGeometry>
    <PathGeometry x:Key="NavigationMenu">M4,6 H20 M4,12 H20 M4,18 H20</PathGeometry>

    <Style x:Key="NavigationGlyph" TargetType="Path">
        <Setter Property="Stroke" Value="{StaticResource NavigationIconBrush}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="{x:Null}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=controls:NavigationMenuItem}}" Value="True">
                <Setter Property="Stroke" Value="{StaticResource NavigationActiveBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Stroke" Value="{StaticResource NavigationActiveBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavigationButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource NavigationTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource DesignFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource DesignBodySize}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="11,9"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <Rectangle x:Name="SelectionIndicator" Width="2" Height="22" RadiusX="1" RadiusY="1"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Fill="{StaticResource NavigationActiveBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=controls:NavigationMenuItem}}" Value="True">
                            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource NavigationHoverBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource NavigationActiveBrush}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=controls:NavigationMenuItem}}" Value="True">
                <Setter Property="Background" Value="{StaticResource NavigationSelectedBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource NavigationActiveBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource NavigationPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavigationToggle" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource NavigationIconBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource NavigationHoverBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource NavigationActiveBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource NavigationPressedBrush}"/></Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
