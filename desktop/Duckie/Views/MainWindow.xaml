<Window x:Class="Duckie.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Duckie.Views"
        xmlns:controls="clr-namespace:Duckie.Views.Controls"
        xmlns:common="clr-namespace:Duckie.Shared.Views.Common;assembly=Duckie.Shared"
        xmlns:loc="clr-namespace:Duckie.Shared.Utils.Localization;assembly=Duckie.Shared"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="{loc:Localize AppTitle}" Height="580" Width="820"
        Background="{StaticResource DesignWorkspaceBrush}" UseLayoutRounding="True">
    <!-- 主内容区域 -->
    <Grid Background="{StaticResource DesignWorkspaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto" MinWidth="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource DesignSurfaceBrush}"
                BorderBrush="{StaticResource DesignBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="8,8,0,4" HorizontalAlignment="Left">
                    <Button Style="{StaticResource NavigationToggle}" Click="ToggleButton_Click"
                            ToolTip="{loc:Localize Nav_ToggleSidebar}" AutomationProperties.Name="{loc:Localize Nav_ToggleSidebar}">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource NavigationMenu}" StrokeThickness="1.8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="topNavMenuContainer" Margin="0,8,0,0"/>
                </ScrollViewer>
                
                <StackPanel x:Name="bottomNavMenuContainer" Grid.Row="2" Margin="0,12,0,8">
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content area -->
        <Grid Grid.Column="1" x:Name="navViewContainer" Margin="10" />
        <common:ToastHost Grid.ColumnSpan="2"/>
    </Grid>
</Window>
