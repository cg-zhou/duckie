<UserControl x:Class="Duckie.Views.Controls.NavigationMenuItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Duckie.Views.Controls"
             mc:Ignorable="d" d:DesignHeight="44" d:DesignWidth="180"
             Margin="6,0,6,4" Focusable="False" UseLayoutRounding="True">
    <Button x:Name="MenuButton" Style="{StaticResource NavigationButton}"
            AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource AncestorType=controls:NavigationMenuItem}}"
            Click="MenuButton_Click">
        <StackPanel Orientation="Horizontal">
            <Viewbox x:Name="IconBox" Width="18" Height="18" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path x:Name="Icon" Style="{StaticResource NavigationGlyph}"/>
                </Canvas>
            </Viewbox>
            <TextBlock x:Name="TextBlock" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{Binding Foreground, ElementName=MenuButton}"
                       FontWeight="{Binding FontWeight, ElementName=MenuButton}"/>
        </StackPanel>
    </Button>
</UserControl>
