<UserControl x:Class="Duckie.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:Duckie.Shared.Utils.Localization;assembly=Duckie.Shared"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="640"
             Background="Transparent" FontFamily="{StaticResource DesignFontFamily}" UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary Source="Brand.xaml"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource DesignPage}">
            <TextBlock Text="{loc:Localize Nav_About}" Style="{StaticResource DesignPageTitle}"/>
            <Border Style="{StaticResource DesignCard}" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Image Source="{StaticResource DuckLogo}" Width="56" Height="56" Margin="0,0,12,0"
                               AutomationProperties.Name="{loc:Localize AppTitle}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe UI" FontSize="36" FontWeight="Bold" Foreground="#202A30"
                                       LineHeight="40" LineStackingStrategy="BlockLineHeight"><Run Text="Duckie"/><Run Text="." Foreground="#D69C13"/></TextBlock>
                            <TextBlock x:Name="versionText" Style="{StaticResource DesignDescription}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{loc:Localize AppDescription}" Style="{StaticResource DesignText}"/>
                    <WrapPanel Margin="-2,16,0,0">
                        <Button x:Name="WebsiteLink" Content="{loc:Localize About_Website}" Style="{StaticResource DesignQuietButton}"
                                Tag="https://duckie.cg-zhou.top" ToolTip="https://duckie.cg-zhou.top" Click="OpenLink_Click"/>
                        <Button Content="GitHub" Style="{StaticResource DesignQuietButton}"
                                Tag="https://github.com/cg-zhou/duckie" ToolTip="https://github.com/cg-zhou/duckie" Click="OpenLink_Click"/>
                        <Button Content="Microsoft Store" Style="{StaticResource DesignQuietButton}"
                                Tag="https://apps.microsoft.com/detail/9msz8m2wxzc4" ToolTip="Microsoft Store" Click="OpenLink_Click"/>
                        <Button Content="{loc:Localize About_Contact}" Style="{StaticResource DesignQuietButton}"
                                Tag="mailto:z_cg@foxmail.com" ToolTip="z_cg@foxmail.com" Click="OpenLink_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border x:Name="RuntimeInfoBorder" Style="{StaticResource DesignCard}" Padding="16" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="RuntimeTitle" Style="{StaticResource DesignRowTitle}"/>
                    <TextBlock x:Name="RuntimeDescription" Style="{StaticResource DesignDescription}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
