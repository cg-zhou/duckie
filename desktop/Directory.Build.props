<Project>
  <PropertyGroup>
    <TargetFramework>net480</TargetFramework>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</Version>
    <UseWPF>true</UseWPF>
    <LangVersion>Latest</LangVersion>
    <ImplicitUsings>true</ImplicitUsings>
  </PropertyGroup>
</Project>
