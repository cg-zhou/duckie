<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:common="clr-namespace:Duckie.Shared.Views.Common">
    <!-- Design baseline: web-booster 0.4.2, src/styles/web-booster.css.
         Keep semantic colors aligned; use compact desktop typography and spacing.
         All styles are opt-in so existing pages can migrate independently. -->
    <SolidColorBrush x:Key="DesignPrimaryBrush" Color="#1E293B"/><!-- CSS: wb-primary -->
    <SolidColorBrush x:Key="DesignTextBrush" Color="#0F172A"/><!-- CSS: wb-text -->
    <SolidColorBrush x:Key="DesignMutedBrush" Color="#64748B"/><!-- CSS: wb-text-muted -->
    <SolidColorBrush x:Key="DesignSurfaceBrush" Color="White"/><!-- opaque CSS: wb-panel -->
    <SolidColorBrush x:Key="DesignWorkspaceBrush" Color="#F8FAFC"/><!-- web-z11g tools workspace -->
    <SolidColorBrush x:Key="DesignBorderBrush" Color="#E5E7EB"/><!-- CSS: wb-card-border -->
    <SolidColorBrush x:Key="DesignInputBorderBrush" Color="#D5DDE7"/><!-- CSS: wb-button-border -->
    <SolidColorBrush x:Key="DesignHoverBrush" Color="#F1F5F9"/><!-- CSS: wb-disabled-bg -->
    <SolidColorBrush x:Key="DesignFocusBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="DesignWarningBrush" Color="#B45309"/>
    <FontFamily x:Key="DesignFontFamily">Microsoft YaHei</FontFamily>
    <sys:Double x:Key="DesignPageWidth">600</sys:Double>
    <sys:Double x:Key="DesignTitleSize">28</sys:Double>
    <sys:Double x:Key="DesignSectionSize">16</sys:Double>
    <sys:Double x:Key="DesignBodySize">13</sys:Double>
    <sys:Double x:Key="DesignCaptionSize">12</sys:Double>
    <Thickness x:Key="DesignPageMargin">24,28,24,32</Thickness>
    <Thickness x:Key="DesignSectionMargin">0,0,0,24</Thickness>
    <Thickness x:Key="DesignRowPadding">16</Thickness>
    <Thickness x:Key="DesignControlPadding">12,6</Thickness>
    <CornerRadius x:Key="DesignCardRadius">12</CornerRadius>
    <CornerRadius x:Key="DesignControlRadius">8</CornerRadius>

    <Style x:Key="DesignPage" TargetType="StackPanel">
        <Setter Property="MaxWidth" Value="{StaticResource DesignPageWidth}"/>
        <Setter Property="Margin" Value="{StaticResource DesignPageMargin}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="DesignText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DesignFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource DesignBodySize}"/>
        <Setter Property="Foreground" Value="{StaticResource DesignTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="DesignPageTitle" TargetType="TextBlock" BasedOn="{StaticResource DesignText}">
        <Setter Property="FontSize" Value="{StaticResource DesignTitleSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,24"/>
    </Style>
    <Style x:Key="DesignSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource DesignText}">
        <Setter Property="FontSize" Value="{StaticResource DesignSectionSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="DesignRowTitle" TargetType="TextBlock" BasedOn="{StaticResource DesignText}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="DesignDescription" TargetType="TextBlock" BasedOn="{StaticResource DesignText}">
        <Setter Property="FontSize" Value="{StaticResource DesignCaptionSize}"/>
        <Setter Property="Foreground" Value="{StaticResource DesignMutedBrush}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="DesignSection" TargetType="StackPanel">
        <Setter Property="Margin" Value="{StaticResource DesignSectionMargin}"/>
    </Style>
    <Style x:Key="DesignCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DesignSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DesignBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource DesignCardRadius}"/>
    </Style>
    <Style x:Key="DesignDivider" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DesignBorderBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="16,0"/>
    </Style>

    <Style x:Key="DesignSettingRow" TargetType="common:SettingRow">
        <Setter Property="Padding" Value="{StaticResource DesignRowPadding}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="common:SettingRow">
                    <Grid Margin="{TemplateBinding Padding}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel x:Name="PART_Copy" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource DesignRowTitle}"/>
                            <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}" Style="{StaticResource DesignDescription}"/>
                        </StackPanel>
                        <ContentPresenter x:Name="PART_Action" Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value=""><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger Property="Description" Value="{x:Null}"><Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standard selection display uses SelectionBoxItem: no language-specific
         template traversal and no fixed text height. Keyboard behavior stays native. -->
    <Style x:Key="DesignSelectItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="{StaticResource DesignControlPadding}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" CornerRadius="4" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DesignHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource DesignHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DesignSelect" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource DesignFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource DesignBodySize}"/>
        <Setter Property="Foreground" Value="{StaticResource DesignTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource DesignSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DesignInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource DesignControlPadding}"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="MaxDropDownHeight" Value="240"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource DesignSelectItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="SelectToggle" Focusable="False" ClickMode="Press"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource DesignControlRadius}">
                                        <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource DesignMutedBrush}"
                                              StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          IsHitTestVisible="False" Margin="12,6,34,6" VerticalAlignment="Center"/>
                        <Border x:Name="FocusRing" BorderBrush="{StaticResource DesignFocusBrush}" BorderThickness="2"
                                CornerRadius="10" Margin="-3" IsHitTestVisible="False" Visibility="Collapsed"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False">
                            <Border Background="{StaticResource DesignSurfaceBrush}" BorderBrush="{StaticResource DesignInputBorderBrush}"
                                    BorderThickness="1" CornerRadius="{StaticResource DesignControlRadius}" Padding="4"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SelectToggle" Property="BorderBrush" Value="{StaticResource DesignFocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DesignShortcutInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource DesignFontFamily}"/>
        <Setter Property="FontSize" Value="{StaticResource DesignCaptionSize}"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Padding" Value="{StaticResource DesignControlPadding}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource DesignSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DesignTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DesignInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource DesignControlRadius}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="FocusRing" BorderBrush="{StaticResource DesignFocusBrush}" BorderThickness="2"
                                CornerRadius="10" Margin="-3" IsHitTestVisible="False" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource DesignHoverBrush}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DesignSwitch" TargetType="CheckBox">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="FocusRing" BorderBrush="Transparent" BorderThickness="2" CornerRadius="12" Padding="2" Background="Transparent">
                        <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="{StaticResource DesignMutedBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Fill="White"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource DesignPrimaryBrush}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.8"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{StaticResource DesignFocusBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
