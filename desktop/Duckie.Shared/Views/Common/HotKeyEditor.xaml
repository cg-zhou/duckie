<UserControl x:Class="Duckie.Shared.Views.Common.HotKeyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Duckie.Shared.Utils.Localization"
             FontFamily="{StaticResource DesignFontFamily}" UseLayoutRounding="True"
             MinWidth="152" MaxWidth="204" HorizontalAlignment="Left">
    <StackPanel>
        <Border x:Name="EditorFrame" Background="{StaticResource DesignSurfaceBrush}"
                BorderBrush="{StaticResource DesignInputBorderBrush}" BorderThickness="1"
                CornerRadius="{StaticResource DesignControlRadius}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="KeyInput" MinHeight="28" Padding="6,3" Cursor="Hand"
                        ToolTip="{loc:Localize Settings_HotKey_Tooltip}"
                        PreviewKeyDown="KeyInput_PreviewKeyDown"
                        GotKeyboardFocus="KeyInput_FocusChanged" LostKeyboardFocus="KeyInput_FocusChanged">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7,0,0,7">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource DesignHoverBrush}"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <ItemsControl x:Name="KeyCaps" IsHitTestVisible="False" Visibility="Collapsed">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource DesignWorkspaceBrush}" BorderBrush="{StaticResource DesignBorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="0,0,3,0" MinWidth="20">
                                        <TextBlock Text="{Binding}" FontFamily="Segoe UI" FontSize="11"
                                                   Foreground="{StaticResource DesignTextBrush}" TextAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="IdleText" FontSize="{StaticResource DesignCaptionSize}"
                                   Foreground="{StaticResource DesignMutedBrush}" TextWrapping="Wrap"/>
                    </Grid>
                </Button>
                <Button x:Name="ClearButton" Grid.Column="1" Width="24" Height="24" Margin="0,0,2,0" VerticalAlignment="Center"
                        Click="ClearButton_Click" ToolTip="{loc:Localize Settings_HotKey_Clear}"
                        AutomationProperties.Name="{loc:Localize Settings_HotKey_Clear}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DesignQuietButton}">
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </Button.Style>
                    <Path Data="M1,1 L9,9 M9,1 L1,9" Width="10" Height="10" StrokeThickness="1.4"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>
        </Border>
        <TextBlock x:Name="RecordingHint" Text="{loc:Localize Settings_HotKey_RecordHint}" Visibility="Collapsed"
                   Style="{StaticResource DesignDescription}"/>
        <TextBlock x:Name="RegistrationStatus" Visibility="Collapsed" TextWrapping="Wrap"
                   Foreground="{StaticResource DesignWarningBrush}" FontSize="{StaticResource DesignCaptionSize}"
                   Margin="0,4,0,0" MaxWidth="204"/>
    </StackPanel>
</UserControl>
