<UserControl x:Class="Duckie.Shared.Views.Common.HotKeyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Duckie.Shared.Views.Common"
             xmlns:loc="clr-namespace:Duckie.Shared.Utils.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="KeyInput" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                 Height="34" MinWidth="150" Padding="10,0" FontFamily="Segoe UI" FontSize="12"
                 VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                 Cursor="Hand" ToolTip="{loc:Localize Settings_HotKey_Tooltip}"
                 PreviewKeyDown="KeyInput_PreviewKeyDown"
                 GotKeyboardFocus="KeyInput_FocusChanged" LostKeyboardFocus="KeyInput_FocusChanged">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="Background" Value="#F8F9FB"/>
                    <Setter Property="BorderBrush" Value="#DDE2E8"/>
                    <Setter Property="Foreground" Value="#344054"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F0F4F8"/>
                            <Setter Property="BorderBrush" Value="#BAC5D2"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Background" Value="#F0F7FF"/>
                            <Setter Property="BorderBrush" Value="#0078D4"/>
                            <Setter Property="Foreground" Value="#0069BA"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
        <common:IconButton x:Name="ClearButton" Grid.Column="1" IconType="Delete"
                           Margin="4,0,0,0" VerticalAlignment="Center" Click="ClearButton_Click"
                           ToolTip="{loc:Localize Settings_HotKey_Clear}"/>
        <TextBlock x:Name="RegistrationStatus" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed"
                   Foreground="#B54708" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
